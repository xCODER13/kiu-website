# JWT
JWT_SECRET=bu_yerga_kamida_64_belgili_tasodifiy_matn_kiriting_masalan_openssl_rand

# Admin
ADMIN_USERNAME=admin
# Eslatma: server.js buni to'g'ridan-to'g'ri o'qimaydi — admin paroli
# MongoDB'dagi "settings" kolleksiyasida ADMIN_PASSWORD_HASH sifatida saqlanadi.
# Bu qator faqat dastlabki bcrypt hash generatsiya qilish uchun eslatma sifatida qoldirilgan.
ADMIN_PASSWORD=<birinchi_parolingiz>

# Telegram
BOT_TOKEN=<telegram_bot_token>
CHANNEL_USERNAME=@kiu_uz
TELEGRAM_CHAT_ID=<telegram_chat_id>

# Supabase (rasm yuklash uchun — News/Events/Teachers admin panelida ishlatiladi)
