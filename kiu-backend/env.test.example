# Test muhiti sozlamalari. Nusxa oling:  .env.test.example  ->  .env.test
# (.env.test gitignore'da; bu fayl esa repoga kiradi).
#
# Diqqat: bu yerga HECH QACHON production qiymatlarini (Atlas URI, kalitlar) yozmang.
# Testlar har test/fayldan keyin kolleksiyalarni tozalaydi va oxirida bazani o'chiradi.
# tests/testDbGuard.js faqat lokal host + "-test" bilan tugaydigan baza nomini qabul qiladi.

# `docker-compose.test.yml` dagi mongo-test konteyneri (host porti 27018)
TEST_MONGODB_URI=mongodb://127.0.0.1:27018/kiu-test
